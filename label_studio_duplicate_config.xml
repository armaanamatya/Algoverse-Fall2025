<View>
  <Header value="Select duplicate images"/>

  <View style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px;">
    <Image name="img1" value="$img1" maxWidth="200" rotateControl="false"/>
    <Image name="img2" value="$img2" maxWidth="200" rotateControl="false"/>
  </View>

  <Header value="Which image is the DUPLICATE? (select one, then click Submit)"/>
  
  <Choices name="duplicate_images" toName="img1" choice="single" required="false">
    <Choice value="img1" alias="Image 1 is the duplicate"/>
    <Choice value="img2" alias="Image 2 is the duplicate"/>
    <Choice value="neither" alias="Neither is a duplicate"/>
  </Choices>
</View>
